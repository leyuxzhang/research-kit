{
  "env": {
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_SSH_COMMAND": "ssh -o BatchMode=yes"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(rh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v:*)",
      "Bash(git push -u origin block/:*)",
      "Bash(git push origin block/:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(uv run:*)",
      "Bash(conda run:*)",
      "Bash(bash -n:*)",
      "Bash(shellcheck:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(chmod +x:*)",
      "Bash(nvidia-smi:*)",
      "Bash(oarstat:*)",
      "mcp__zotero"
    ],
    "deny": [
      "Bash(sbatch:*)",
      "Bash(scancel:*)",
      "Bash(oarsub:*)",
      "Bash(oardel:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/research-kit/**)",
      "Bash(cat ~/.config/research-kit/:*)",
      "Bash(source ~/.config/research-kit/:*)"
    ]
  }
}
