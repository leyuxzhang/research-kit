#!/bin/bash
#SBATCH --job-name={{job_name}}
#SBATCH --account={{account}}@{{account_suffix}}
#SBATCH -C {{constraint}}
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:{{gpus}}
#SBATCH --cpus-per-task={{cpus}}
#SBATCH --hint=nomultithread
#SBATCH --time={{walltime}}
#SBATCH --qos={{qos}}
#SBATCH --output={{log_dir}}/%x_%j.out
#SBATCH --error={{log_dir}}/%x_%j.err
{{array_line}}
# Generated by research-kit — plan {{plan}}, block {{block}}, commit {{commit}}.
# Submit (from a Jean Zay login node):  sbatch {{script_path}}
set -eo pipefail

{{modules}}
{{env_setup}}
# Compute nodes have no internet access: everything must be pre-downloaded.
{{offline_env}}

cd {{code_dir}}
# For job arrays, SLURM_ARRAY_TASK_ID starts at the first index of --array.
RUN_DIR={{run_dir}}
srun bash launch/run_wrapper.sh "$RUN_DIR" -- {{command}}
